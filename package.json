{
  "name": "@ludic/ein",
  "version": "2.0.0",
  "description": "A small, strongly typed Entity Component System for games",
  "keywords": [
    "ecs",
    "entity-component-system",
    "game",
    "gamedev",
    "typescript"
  ],
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ludic/ein.git"
  },
  "homepage": "https://github.com/Ludic/ein#readme",
  "bugs": {
    "url": "https://github.com/Ludic/ein/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./reactivity": {
      "types": "./dist/reactivity.d.ts",
      "default": "./dist/reactivity.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./hmr": {
      "types": "./dist/hmr.d.ts",
      "default": "./dist/hmr.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p tests/tsconfig.json && tsc -p examples/tsconfig.json",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "examples": "vite --config examples/vite.config.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@vue/reactivity": "^3.5.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "@vue/reactivity": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/reactivity": "^3.5.44",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
